rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function employeeProfile() {
      return get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data;
    }

    match /employeeProfiles/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list, create, update, delete: if false;
    }

    match /artifacts/car-booking-system/public/data/bookings/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.employeeId == employeeProfile().employeeId
        && request.resource.data.bookerName == employeeProfile().fullName
        && request.resource.data.department == employeeProfile().department
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status in ['approved', 'return_rejected']
        && request.resource.data.status == 'pending_audit'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'mileageStart', 'mileageEnd', 'fuelCost', 'note'
        ])
        && request.resource.data.mileageStart is number
        && request.resource.data.mileageEnd is number
        && request.resource.data.fuelCost is number
        && request.resource.data.mileageStart >= 0
        && request.resource.data.mileageEnd >= request.resource.data.mileageStart
        && request.resource.data.fuelCost >= 0
      );
      allow delete: if isAdmin();
    }

    match /bookingContacts/{bookingId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.employeeId == employeeProfile().employeeId
        && request.resource.data.phone == employeeProfile().phone;
      allow update, delete: if isAdmin();
    }

    match /artifacts/car-booking-system/public/data/logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
